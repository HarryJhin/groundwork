#!/usr/bin/env bash
# 플랜 하나가 쓰는 단명 산출물(태스크 브리프·구현자 리포트·리뷰 패키지·진행 기록)의
# 워킹 트리 디렉터리를 확정하고 만든다. 그 절대 경로를 출력한다.
#
# 플랜마다 디렉터리 하나다(.groundwork/sdd/<plan-basename>/). 같은 워킹 트리의 후속
# 플랜이 다른 플랜의 산출물을 읽거나 덮어쓸 수 없다. 낡은 진행 기록을 현재 진행으로
# 오독하면 컨트롤러가 완료된 태스크 묶음을 통째로 건너뛴다. 플랜 단위 격리가 그
# 실패를 구조적으로 없앤다.
#
# 워크스페이스를 .git/ 밑이 아니라 워킹 트리에 두는 이유가 있다. Claude Code는 .git/을
# 보호 경로로 취급해 에이전트 쓰기를 거부하고 그러면 구현자 서브에이전트가 리포트
# 파일을 쓰지 못한다.
#
# .groundwork/는 전부 스크래치다. 커밋할 산출물(스펙·플랜·ADR)은 docs/에 산다.
# 그래서 자기 자신을 ignore하는 .gitignore를 sdd/가 아니라 .groundwork/에 둔다.
# sdd/에만 두면 나중에 .groundwork/ 밑에 다른 임시 디렉터리가 생겼을 때 그것이
# 대상 repo의 git status로 샌다. 이 파일은 없을 때만 쓴다. 이미 있으면 그 repo가
# 자기 규칙을 넣었을 수 있으므로 덮어쓰지 않는다.
#
# 워크스페이스 위치의 단일 정본이다. task-brief와 review-package가 서로 다른
# 디렉터리로 갈라지지 않게 한다.
#
# 사용법: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
scratch="$root/.groundwork"
dir="$scratch/sdd/$slug"
mkdir -p "$dir"
[ -e "$scratch/.gitignore" ] || printf '*\n' > "$scratch/.gitignore"
cd "$dir" && pwd
