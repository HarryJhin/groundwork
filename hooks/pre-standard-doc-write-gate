#!/usr/bin/env bash
# PreToolUse (Write|Edit) hook for the groundwork plugin.
#
# 리포 표준 문서(README·CONTRIBUTING·CODE_OF_CONDUCT·SECURITY·SUPPORT·GOVERNANCE·
# CHANGELOG·이슈 템플릿·PR 템플릿)를 쓰는 시점에 그 문서의 표준 요지와 읽을
# 레퍼런스를 작성자 모델에 준다. groundwork:managing-repo-standard-docs 스킬이 정본이고
# 이 훅은 그 스킬로 들어가는 입구다.
#
# 대상은 GitHub이 인식하는 위치에 놓인 문서뿐이다. 리포 루트·`.github/`·`docs/` 셋이고
# CHANGELOG는 루트만이다. 하위 디렉터리의 동명 파일(패키지 README, 픽스처, vendor)은
# 통과시킨다. 파일명만 보고 걸면 리포 안 모든 README가 걸려 완성된 쓰기가 폐기된다.
#
# 신규 파일과 기존 파일을 다르게 다룬다.
#   신규: 차단(exit 2)하고 표준 요지를 준다. 아직 초안이 없으니 잃을 것이 없다.
#   기존: 차단하지 않고 한 줄만 준다. 스킬이 "단일 파일 한 줄 수정은 대상이 아니다"라고
#         규정하므로 오타 하나에 재작성을 강요하지 않는다.
#
# 차단은 세션 안에서 문서 종류마다 한 번이다. 파일마다 차단하지 않는다.
# 안내 내용은 종류별로 고정이라 두 번째부터는 새 정보가 없다.
#
# 파싱·환경 실패는 전부 무해 통과(exit 0)다. 이 훅이 작업을 막지 않는다.

set -u

INPUT=$(cat 2>/dev/null) || exit 0
[ -n "$INPUT" ] || exit 0

# 대상 경로 추출. 실행 환경마다 편집 도구의 입력 스키마가 다르다.
# Claude Code의 Write·Edit은 tool_input.file_path에 경로 하나를 준다.
# Codex의 apply_patch는 tool_input.command에 패치 본문을 주고 대상 파일은
# "*** Add File: <경로>"와 "*** Update File: <경로>" 줄에 있다.
if command -v jq >/dev/null 2>&1; then
  FILE_PATH=$(printf '%s' "$INPUT" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
  PATCH=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
  SID=$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null)
else
  FILE_PATH=$(printf '%s' "$INPUT" | sed -n 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  PATCH=""
  SID=$(printf '%s' "$INPUT" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
fi

if [ -n "${FILE_PATH:-}" ]; then
  CANDIDATES="$FILE_PATH"
elif [ -n "${PATCH:-}" ]; then
  # BRE의 \| 는 GNU 확장이라 BSD sed에서 안 먹는다. 표현식을 둘로 나눠 이식성을 지킨다.
  CANDIDATES=$(printf '%s\n' "$PATCH" \
    | sed -n -e 's/^\*\*\* Add File:[[:space:]]*//p' -e 's/^\*\*\* Update File:[[:space:]]*//p')
else
  CANDIDATES=""
fi

[ -n "$CANDIDATES" ] || exit 0

# 후보 경로를 리포 루트 기준 상대 경로로 바꾼다. 리포 밖이면 rc=1.
repo_rel() {
  local cand="$1" dir root
  case "$cand" in /*) ;; *) cand="$PWD/$cand" ;; esac
  dir="$(dirname "$cand")"
  # 아직 없는 디렉터리에 쓰는 경우가 있으므로 존재하는 조상까지 거슬러 올라간다.
  while [ ! -d "$dir" ] && [ "$dir" != "/" ] && [ "$dir" != "." ]; do dir="$(dirname "$dir")"; done
  root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -n "$root" ] || return 1
  case "$cand" in
    "$root"/*) printf '%s\n' "${cand#"$root"/}" ;;
    *) return 1 ;;
  esac
}

# JSON 임베딩용 이스케이프. 레퍼런스 제목에 큰따옴표가 들어가는 절이 있다.
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# 비차단 안내는 JSON additionalContext로 낸다. PreToolUse에서 exit 0의 평문 stdout은
# 디버그 로그로만 가고 모델에 닿지 않는다. 평문으로 내면 안내가 통째로 사라진다.
emit_context() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"%s"}}\n' \
    "$(escape_for_json "$1")"
}

# 후보 중 게이트 대상 하나를 고른다. 없으면 통과.
# 개행만 구분자로 두어 공백이 든 경로도 한 후보로 읽는다.
KIND=""
SLUG=""
REF=""
GUIDE=""
FILE_PATH=""
OLD_IFS="$IFS"
IFS='
'
for CANDIDATE in $CANDIDATES; do
  REL="$(repo_rel "$CANDIDATE")" || continue
  BASE="${REL##*/}"
  DIRPART="${REL%/*}"
  [ "$DIRPART" = "$REL" ] && DIRPART=""
  # CONTRIBUTING과 PR 템플릿의 파일명은 GitHub이 "not case sensitive"라고 명시한다.
  # 나머지는 규정이 없거나(README·CoC·GOVERNANCE) 전대문자 규정이 있어(SUPPORT) 정확히 본다.
  LOWER="$(printf '%s' "$BASE" | tr '[:upper:]' '[:lower:]')"

  case "$REL" in
    .github/ISSUE_TEMPLATE/config.yml|.github/ISSUE_TEMPLATE/config.yaml)
      KIND="이슈 템플릿 chooser"
      SLUG="issue-config"
      REF="references/github-standard.md 「config.yml (template chooser)」"
      GUIDE="- 이 파일은 템플릿이 아니라 선택 화면 설정이다. \`name:\`·\`about:\` 같은 템플릿 키는 여기 쓰지 않는다.
- 유효한 최상위 키는 \`blank_issues_enabled\`와 \`contact_links\` 둘이다.
- \`contact_links\` 항목마다 \`name\`·\`url\`·\`about\`을 넣는다. 질문·토론처럼 이슈가 아닌 것을 다른 곳으로 보내는 것이 목적이다.
- \`blank_issues_enabled: false\`로 두면 빈 이슈를 maintainer에게만 노출한다."
      ;;
    .github/ISSUE_TEMPLATE/*)
      KIND="이슈 템플릿"
      SLUG="issue-template"
      REF="references/github-standard.md 「Issue and pull request templates」"
      GUIDE="- 위치는 default 브랜치의 \`.github/ISSUE_TEMPLATE/\`만 유효하다. 루트·docs에 두면 GitHub이 무시한다.
- 마크다운은 frontmatter에 \`name:\`·\`about:\`, 이슈 폼(.yml)은 \`name:\`·\`description:\`이 유효해야 체크마크가 붙는다.
- 템플릿 이름은 3자를 초과해야 이슈 생성 화면에 보인다.
- \`labels:\`에 적은 label은 자동 생성되지 않는다. 리포에 이미 있어야 한다.
- \`validations.required\`는 public 리포에서만 동작한다.
- 파일명 숫자 프리픽스(\`1-bug.yml\`)로 표시 순서를 정한다. YAML이 Markdown보다 먼저 나온다."
      ;;
    .github/PULL_REQUEST_TEMPLATE/*|PULL_REQUEST_TEMPLATE/*|docs/PULL_REQUEST_TEMPLATE/*)
      KIND="PR 템플릿"
      SLUG="pr-template"
      REF="references/github-standard.md 「Issue and pull request templates」"
      GUIDE="- 이 디렉터리 형태는 다중 PR 템플릿이다. \`?template=파일명\` 쿼리 파라미터로 고른다.
- 리뷰어가 확인해야 하는 것만 남긴다. 항목이 많으면 아무도 안 채운다.
- 체크박스는 작성자가 참·거짓을 판정할 수 있는 문장으로 쓴다. \"테스트를 충분히 했다\"가 아니라 \"추가한 동작에 대한 테스트가 있다\"."
      ;;
    *)
      # 나머지는 3개 인식 위치(루트·.github·docs)에 놓인 것만 대상이다.
      case "$DIRPART" in
        ""|.github|docs) ;;
        *) continue ;;
      esac
      case "$BASE" in
        README.md|README.markdown)
          KIND="README"
          SLUG="readme"
          REF="references/readme-standard.md"
          GUIDE="- 실측상 What(97%)과 How(88%)는 대부분 채우고 Why(26%)와 When(21%)은 네 리포 중 세 곳이 빠뜨린다. 그 둘을 먼저 쓴다.
- 배치 순서: 제목과 한 문단 요약(What) → 왜 이 선택인가(Why) → 상태와 지원 범위(When) → 설치부터 첫 성공까지(How) → 다른 표준 문서 링크.
- Why는 \"기존 대안 대신 이걸 고를 이유\"다. 분류(\"~용 라이브러리\")는 What이지 Why가 아니다.
- When은 실험·안정·보관 중 무엇인지와 어디까지 검증했는지다.
- 리포 안 링크는 상대 경로로 쓴다. 브랜치에 맞춰 자동 변환되고 clone 한 쪽에서도 동작한다.
- 렌더 뷰는 500 KiB에서 잘린다."
          ;;
        CODE_OF_CONDUCT.md|CODE_OF_CONDUCT.markdown|CODE_OF_CONDUCT)
          KIND="CODE_OF_CONDUCT"
          SLUG="coc"
          REF="references/industry-practices.md 「The de facto common denominator for a CoC is Contributor Covenant」"
          GUIDE="- Contributor Covenant 채택이 사실상 표준이다. 자체 문안을 새로 쓰지 않는다.
- **집행 연락처(이메일)를 반드시 채운다.** 플레이스홀더를 남기면 그 CoC는 장식이다.
- 집행 의지와 능력이 있는지 먼저 사용자에게 확인한다. 신고를 받고도 대응할 사람이 없으면 채택 자체를 다시 판단한다.
- community profile 체크마크는 GitHub 제공 템플릿으로 만들었을 때만 붙는다. 손으로 쓴 CoC는 동작해도 완료로 표시되지 않는다.
- 남의 문안을 쓰면 attribution 지침을 따른다."
          ;;
        SECURITY.md|SECURITY.markdown|SECURITY)
          KIND="SECURITY"
          SLUG="security"
          REF="references/industry-practices.md 「SECURITY rests on \"no public disclosure plus a private channel\", and the channel scales with size」"
          GUIDE="- 셋을 담는다. (1) 사적 보고 경로 (2) 지원 버전 표 (3) 공개 이슈로 신고하지 말라는 지시.
- 소규모는 GitHub private vulnerability reporting으로 충분하다. 전용 포털·버그바운티는 대규모의 선택지다.
- 지원 버전은 추측하지 않는다. 어느 버전까지 보안 수정을 받는지 사용자에게 확인한다.
- 응답 시한을 적을 거면 지킬 수 있는 값만 적는다."
          ;;
        SUPPORT.md|SUPPORT.markdown|SUPPORT)
          KIND="SUPPORT"
          SLUG="support"
          REF="references/github-standard.md 「SUPPORT」"
          GUIDE="- 파일명은 전부 대문자여야 한다. GitHub이 대소문자를 규정한 몇 안 되는 파일이다.
- 질문을 어디로 보낼지 채널별로 적는다. 버그는 이슈, 사용법 질문은 다른 곳으로 가르는 것이 목적이다.
- 실재하고 사람이 보고 있는 채널만 적는다. 죽은 채널을 적으면 이슈 트래커로 되돌아온다.
- README에서 이 문서로 링크한다."
          ;;
        GOVERNANCE.md|GOVERNANCE.markdown|GOVERNANCE)
          KIND="GOVERNANCE"
          SLUG="governance"
          REF="references/github-standard.md 「GOVERNANCE」"
          GUIDE="- GitHub은 이 문서의 내용을 규정하지 않는다. 무엇을 담을지는 프로젝트 선택이므로 사용자에게 확인하고 쓴다.
- 답할 물음은 셋이다. 누가 무엇을 결정하는가, 그 권한을 어떻게 얻고 잃는가, 의견이 갈리면 어떻게 정하는가.
- 실제 운영과 다른 것을 쓰지 않는다. 1인 프로젝트에 위원회 구조를 적으면 문서가 거짓이 된다."
          ;;
        CHANGELOG.md|CHANGELOG.markdown|CHANGELOG)
          # Keep a Changelog가 정한 위치는 리포 루트다. GitHub 인식 위치와 무관하다.
          [ -n "$DIRPART" ] && continue
          KIND="CHANGELOG"
          SLUG="changelog"
          REF="references/changelog-standard.md"
          GUIDE="- 근거는 Keep a Changelog 1.1.0과 Semantic Versioning 2.0.0이다. GitHub 표준이 아니므로 준수 선언을 파일 첫머리에 쓴다.
- 종류는 여섯뿐이다. Added·Changed·Deprecated·Removed·Fixed·Security. 새 제목을 만들지 않는다.
- 맨 위에 \`Unreleased\` 구역, 그 아래 최신 버전부터 역순. 날짜는 \`YYYY-MM-DD\`.
- 커밋 로그나 PR 제목을 그대로 붙이지 않는다. 항목마다 \"이 사용자에게 무슨 일이 생기는가\"를 쓴다.
- 호환성을 깨는 변경은 MAJOR를 올린다. 0.x면 그 사실을 README 상태 절에 밝힌다."
          ;;
        *)
          case "$LOWER" in
            contributing.md|contributing.markdown|contributing)
              KIND="CONTRIBUTING"
              SLUG="contributing"
              REF="references/industry-practices.md 「CONTRIBUTING splits into a generic half and a per-repo half」"
              GUIDE="- 이 리포에서만 참인 것을 쓴다. 빌드 명령, 테스트 실행 방법, 디렉터리 구조, PR 흐름이 그것이다.
- 프로젝트가 달라도 같은 내용(행동 기대치, 라이선스 동의, 일반 Git 사용법)은 링크로 위임한다. 둘을 섞으면 어느 쪽도 최신으로 유지되지 않는다.
- 명령은 복사해서 그대로 실행되는 형태로 적는다. 실제로 돌려보고 적는다.
- CODE_OF_CONDUCT로 가는 링크를 둔다.
- CLA를 요구할지는 법적 필요가 있을 때만 정한다. 기본값이 아니고 기여 진입장벽 비용이 있다."
              ;;
            pull_request_template.md|pull_request_template.markdown|pull_request_template.txt)
              KIND="PR 템플릿"
              SLUG="pr-template"
              REF="references/github-standard.md 「Issue and pull request templates」"
              GUIDE="- 리뷰어가 확인해야 하는 것만 남긴다. 항목이 많으면 아무도 안 채운다.
- 체크박스는 작성자가 참·거짓을 판정할 수 있는 문장으로 쓴다. \"테스트를 충분히 했다\"가 아니라 \"추가한 동작에 대한 테스트가 있다\".
- 여러 종류가 필요하면 지원 폴더 안 \`PULL_REQUEST_TEMPLATE/\` 하위 디렉터리에 두고 \`?template=\`으로 고른다."
              ;;
            *)
              continue
              ;;
          esac
          ;;
      esac
      ;;
  esac
  FILE_PATH="$CANDIDATE"
  break
done
IFS="$OLD_IFS"

[ -n "$FILE_PATH" ] || exit 0

SKILL="groundwork:managing-repo-standard-docs"

# 이미 있는 문서는 차단하지 않는다. 한 줄만 준다.
if [ -e "$FILE_PATH" ]; then
  emit_context "[groundwork] ${KIND} 문서를 고치는 중이다. 구조·표준을 건드리는 변경이면 ${SKILL} 스킬의 ${REF}를 읽고 진행한다."
  exit 0
fi

# 세션 안에서 문서 종류마다 1회. 마커가 있으면 차단하지 않고 한 줄만 준다.
MARK_ROOT="${TMPDIR:-/tmp}/groundwork-standard-doc-gate/${SID:-nosession}"
KEY="${SLUG:-other}"
if [ -f "$MARK_ROOT/$KEY" ]; then
  emit_context "[groundwork] ${KIND} 문서를 하나 더 만드는 중이다. 이 세션 앞에서 받은 표준을 그대로 적용한다. 차단하지 않는다."
  exit 0
fi
mkdir -p "$MARK_ROOT" 2>/dev/null && : > "$MARK_ROOT/$KEY" 2>/dev/null

# 차단(exit 2)의 사유는 stderr로 전달한다. PreToolUse에서 모델이 읽는 채널이다.
cat >&2 <<EOF
[groundwork] 새 ${KIND} 문서를 만드는 중이다. 쓰기 전에 이 문서의 표준을 적용한다.

${GUIDE}

프로젝트 고유 정보(연락처, 지원 버전, 빌드·테스트 명령, 담당자)는 추측으로 채우지 않는다.
모르면 사용자에게 묻는다. 플레이스홀더를 남긴 채 완료로 넘기지 않는다.

판정 체크리스트와 근거는 ${SKILL} 스킬의 ${REF}에 있다.
위 요지는 발췌다. 그 레퍼런스를 읽고 쓴다.

이 안내는 이 세션에서 ${KIND} 문서를 처음 만들 때 한 번만 나온다. 다시 Write하면 통과하고
이후 이 세션의 ${KIND} 문서는 차단하지 않는다. 표준은 계속 적용한다.
EOF

exit 2
