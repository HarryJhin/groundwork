#!/usr/bin/env bash
# PreToolUse (Write|Edit) hook for the groundwork plugin.
#
# groundwork 산출물(스펙·플랜·ADR·스킬)을 새로 만드는 시점에 주니어 독자 규범을
# 작성자 모델에 주입한다. 리뷰에서 뒤늦게 반려하는 대신 쓰기 직전에 알린다.
#
# 신규 파일에만 건다. 이미 있는 파일 편집은 통과시킨다(초안 손실을 막고,
# 재작성 루프를 만들지 않기 위해서다).
# 파일마다 한 번만 차단한다. 마커를 남겨 같은 파일의 재시도는 통과시킨다.
#
# 파싱·환경 실패는 전부 무해 통과(exit 0)다. 이 훅이 작업을 막지 않는다.

set -u

INPUT=$(cat 2>/dev/null) || exit 0
[ -n "$INPUT" ] || exit 0

# 대상 경로 추출. 실행 환경마다 편집 도구의 입력 스키마가 다르다.
# Claude Code의 Write·Edit은 tool_input.file_path에 경로 하나를 준다.
# Codex의 apply_patch는 tool_input.command에 패치 본문을 주고, 신규 파일은
# 그 안의 "*** Add File: <경로>" 줄에 있다(한 패치가 여러 파일을 만들 수 있다).
if command -v jq >/dev/null 2>&1; then
  FILE_PATH=$(printf '%s' "$INPUT" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
  PATCH=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
  SID=$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null)
else
  FILE_PATH=$(printf '%s' "$INPUT" | sed -n 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  PATCH=""
  SID=$(printf '%s' "$INPUT" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
fi

# 후보 경로 목록. 줄 하나에 경로 하나다.
if [ -n "${FILE_PATH:-}" ]; then
  CANDIDATES="$FILE_PATH"
elif [ -n "${PATCH:-}" ]; then
  CANDIDATES=$(printf '%s\n' "$PATCH" | sed -n 's/^\*\*\* Add File:[[:space:]]*//p')
else
  CANDIDATES=""
fi

[ -n "$CANDIDATES" ] || exit 0

# 후보 중 게이트 대상 하나를 고른다. 없으면 통과.
# 개행만 구분자로 두어 공백이 든 경로도 한 후보로 읽는다.
KIND=""
FILE_PATH=""
OLD_IFS="$IFS"
IFS='
'
for CANDIDATE in $CANDIDATES; do
  # 이미 존재하는 파일은 신규 작성이 아니다.
  [ -e "$CANDIDATE" ] && continue
  case "$CANDIDATE" in
    */docs/specs/SPEC-*.md|docs/specs/SPEC-*.md)
      KIND="스펙"
      EXTRA="- 고유 용어·약칭·코드명을 셋 이상 쓰면 목표 앞에 「용어」 절을 두고 한자리에 모은다.
- 결론만 적는다. \"TBD\"·\"구현하며 결정\"은 스펙 결함이다."
      ;;
    */docs/plans/PLAN-*.md|docs/plans/PLAN-*.md)
      KIND="플랜"
      EXTRA="- 구현자는 플랜 전문이 아니라 자기 태스크 하나를 뽑은 브리프만 받는다. 태스크 본문이
  플랜 서두나 다른 태스크의 정의에 기대면 그 정의는 구현자에게 도달하지 않는다.
- 앞 태스크의 산출물에 기대면 Interfaces의 Consumes에 적는다. 거기 없는 의존은 전달되지 않는다.
- Global Constraints는 스펙에서 값 그대로 옮긴다. 요약하면 값을 잃는다."
      ;;
    */docs/adr/ADR-*.md|docs/adr/ADR-*.md)
      KIND="ADR"
      EXTRA="- Consequences의 Negative는 기재 의무다. 긍정 효과만 나열하면 미완성이다.
- 규범이 아니라 결정 기록이다. 결정을 강제한 힘을 Context에 적는다."
      ;;
    */skills/*/SKILL.md|skills/*/SKILL.md)
      KIND="스킬"
      EXTRA="- 실행 계약 절이 없으면 스킬이 시작조차 못 한다. 아래를 모두 담는다.
  (1) 입력: 무엇을 받는가, 못 받으면 어떻게 하는가
  (2) 경로 기준: 문서가 적은 상대 경로의 기준 디렉터리(실행 시점 작업 디렉터리와 다르다)
  (3) 주체: 이 문서를 실행하는 것이 누구이고 다른 역할 이름과 어떤 관계인가
  (4) 출력: 무엇을 반환하고 어디로 넘기는가
- 셸 블록을 담으면 변수 대입이 문서 안에 있는지, 블록들이 같은 셸에서 도는 전제인지 밝힌다.
- description은 트리거만 담는다. 절차를 요약하면 에이전트가 본문을 읽지 않는다."
      ;;
    *)
      continue
      ;;
  esac
  FILE_PATH="$CANDIDATE"
  break
done
IFS="$OLD_IFS"

[ -n "$FILE_PATH" ] || exit 0

# 파일 단위 1회. 마커가 있으면 통과.
MARK_ROOT="${TMPDIR:-/tmp}/groundwork-junior-gate/${SID:-nosession}"
KEY=$(printf '%s' "$FILE_PATH" | tr '/ ' '__')
if [ -f "$MARK_ROOT/$KEY" ]; then
  exit 0
fi
mkdir -p "$MARK_ROOT" 2>/dev/null && : > "$MARK_ROOT/$KEY" 2>/dev/null

cat >&2 <<EOF
[groundwork] ${KIND} 문서를 새로 만드는 중이다. 쓰기 전에 주니어 독자 규범을 적용한다.

이 문서를 읽을 사람은 세션 맥락이 없다. 이 대화에 있었던 것은 그에게 없다.
그가 가진 것은 셋뿐이다. 문서 전문(순차 독해), 리포(코드 + 위치가 명시된 참조물), 일반 기술 지식.

지금 쓰려던 내용에 아래를 적용해 다시 Write하라.

1. 지식 경계
   명사·약칭·코드명마다 묻는다. 이 리포 밖 표준 자료에서 정의를 찾을 수 있는가.
   - 못 찾으면 문서 안에 정의를 둔다.
   - 표준 용어를 다른 뜻으로 쓸 거면 첫 등장에서 재정의한다. 재정의 없이 쓰면 독자는
     아는 단어라 믿고 틀린 뜻으로 끝까지 읽는다. 막혔다는 신호조차 받지 못한다.
   - 약어·두문자는 첫 등장에서 푼다.
   - 문장이 성립하려면 참이어야 하는 조건을 문서 안에 둔다.
   - 일반 지식인지 도메인 지식인지 애매하면 도메인 지식으로 다룬다.
2. 참조 해소
   외부 실체는 정식 명칭 + 한 줄 정체 + 위치를 붙인다.
   상대 경로는 기준 디렉터리를 밝힌다. 문서가 놓인 위치와 독자의 실행 위치는 다르다.
3. 전방 참조
   정의를 사용보다 앞에 둔다. 뒤에 있는 정의는 순차 독해자에게 없는 것과 같다.
4. 서술 판독
   한 문장에 독립 진술 하나. 지시어의 대상을 같은 문장 안에.
   한 결정에 필요한 정보를 한자리에 모은다. 같은 규칙을 두 곳에서 다른 값으로 적지 않는다.
5. 단독 판독
   결정·요구는 배경 서사 없이 그 문장만으로 읽히게 쓴다.
6. 표기 체계
   번호·코드 체계를 섞으면 읽는 법을 문서 안에 둔다.

[${KIND} 추가]
${EXTRA}

규범 전문과 판정 렌즈는 groundwork:writing-for-junior 스킬에 있다.
이 안내는 파일마다 한 번만 나온다. 다시 Write하면 통과한다.
EOF

exit 2
